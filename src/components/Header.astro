---
const links = [
  { href: '#projects', label: 'Projects' },
  { href: '#about', label: 'About' },
  { href: '/resume.pdf', label: 'Resume' },
  { href: '#contact', label: 'Contact' },
];
---
<header class="sticky top-0 z-50 backdrop-blur bg-base-950/70 border-b border-white/5">
  <nav class="max-w-5xl mx-auto flex items-center justify-between px-6 py-6">
    <a href="/" class="bg-transparent border border-accent-purple px-4 py-2 rounded-lg font-display font-semibold text-lg tracking-tight">
      D
    </a>
    <ul class="flex gap-6 text-sm md:text-m text-slate-400">
      {links.map((link) => (
        <li>
          <a href={link.href} class="hover:text-white transition-colors">{link.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
