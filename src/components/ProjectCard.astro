---
interface Props {
  title: string;
  summary: string;
  stack: string[];
  liveUrl?: string;
  repoUrl: string;
  slug: string;
}
const { title, summary, stack, liveUrl, repoUrl, slug } = Astro.props;
---
<article class="rounded-2xl border border-white/5 bg-base-900 p-8 hover:border-accent-purple/40 transition-colors reveal">
  <h3 class="font-display text-2xl font-semibold">{title}</h3>
  <p class="mt-3 text-slate-400">{summary}</p>

  <ul class="mt-4 flex flex-wrap gap-2">
    {stack.map((tech) => (
      <li class="text-xs font-mono px-2 py-1 rounded bg-white/5 text-slate-300">{tech}</li>
    ))}
  </ul>

  <div class="mt-6 flex gap-4 text-sm">
    {liveUrl && (
      <a href={liveUrl} class="text-accent-purple hover:underline">Live demo →</a>
    )}
    <a href={repoUrl} class="text-slate-400 hover:text-white transition-colors">Source code</a>
    <a href={`/projects/${slug}`} class="text-slate-400 hover:text-white transition-colors">Full writeup</a>
  </div>
</article>
